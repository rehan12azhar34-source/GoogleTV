<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C10">

    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#800B0C10" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="8dp">

                <TextView android:id="@+id/btnProfile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="👤" android:textColor="#FFFFFF" android:textSize="13sp" />

                <HorizontalScrollView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:scrollbars="none">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/tabForYou" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="For you" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tabMovies" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Movies" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tabShows" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Shows" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tabApps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Apps" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tabLibrary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Library" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView android:id="@+id/btnSearch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="🔍" android:textColor="#FFFFFF" android:textSize="13sp" />
                <TextView android:id="@+id/btnSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="⚙" android:textColor="#FFFFFF" android:textSize="13sp" />
                <TextView android:id="@+id/txtBrand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Aura TV" android:textColor="#E8EAED" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout android:id="@+id/heroContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="14dp" android:paddingBottom="10dp">
                <TextView android:id="@+id/heroSourceBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="#88000000" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="▶ MXPLAYER TV" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/heroTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="2" android:text="Aashram" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/heroSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="#66000000" android:maxLines="2" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:textColor="#E8EAED" android:textSize="12sp" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/btnHeroWatch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/bg_pill" android:clickable="true" android:focusable="true" android:paddingHorizontal="16dp" android:paddingVertical="7dp" android:text="▶ Watch" android:textColor="#121212" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnHeroBookmark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="14dp" android:paddingVertical="7dp" android:text="+ Library" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnHeroPrev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="‹" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <TextView android:id="@+id/btnHeroNext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="›" android:textColor="#FFFFFF" android:textSize="14sp" />
                    <LinearLayout android:id="@+id/heroDotsLayout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/homeSectionsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/txtRow1Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginBottom="8dp" android:background="#55000000" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="Top picks for you" android:textColor="#E8EAED" android:textSize="13sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRow1" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:paddingHorizontal="24dp" />

                <TextView android:id="@+id/txtAppsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="14dp" android:layout_marginBottom="8dp" android:background="#55000000" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="Your apps" android:textColor="#E8EAED" android:textSize="13sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAppsRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:paddingHorizontal="24dp" />

                <TextView android:id="@+id/txtRow2Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="14dp" android:layout_marginBottom="8dp" android:background="#55000000" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="Live Trending Shows" android:textColor="#E8EAED" android:textSize="13sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRow2" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:paddingHorizontal="24dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/appsGridContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="10dp" android:visibility="gone">
                <TextView android:id="@+id/txtGridTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="Installed Apps" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtEmptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="32dp" android:textColor="#B8BDC8" android:textSize="14sp" android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout android:id="@+id/searchOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F20B0C10" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/edtSearch" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="#28FFFFFF" android:hint="Search movies, shows, apps..." android:inputType="text" android:paddingHorizontal="14dp" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" android:textSize="14sp" />
            <TextView android:id="@+id/btnCloseSearch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:background="@drawable/bg_tab" android:clickable="true" android:focusable="true" android:paddingHorizontal="14dp" android:paddingVertical="9dp" android:text="Close" android:textColor="#FFFFFF" android:textStyle="bold" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSearchMedia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSearchApps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/remoteOverlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="14dp" android:background="#CC16181F" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:visibility="gone">
        <TextView android:id="@+id/remUp" android:layout_width="38dp" android:layout_height="32dp" android:background="#33FFFFFF" android:gravity="center" android:text="▲" android:textColor="#FFFFFF" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginVertical="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/remLeft" android:layout_width="38dp" android:layout_height="34dp" android:background="#33FFFFFF" android:gravity="center" android:text="◀" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/remOk" android:layout_width="42dp" android:layout_height="34dp" android:layout_marginHorizontal="4dp" android:background="#E8EAED" android:gravity="center" android:text="OK" android:textColor="#121212" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/remRight" android:layout_width="38dp" android:layout_height="34dp" android:background="#33FFFFFF" android:gravity="center" android:text="▶" android:textColor="#FFFFFF" />
        </LinearLayout>
        <TextView android:id="@+id/remDown" android:layout_width="38dp" android:layout_height="32dp" android:background="#33FFFFFF" android:gravity="center" android:text="▼" android:textColor="#FFFFFF" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <TextView android:id="@+id/remBack" android:layout_width="52dp" android:layout_height="28dp" android:layout_marginEnd="4dp" android:background="#26FFFFFF" android:gravity="center" android:text="Back" android:textColor="#FFFFFF" android:textSize="11sp" />
            <TextView android:id="@+id/remClose" android:layout_width="28dp" android:layout_height="28dp" android:background="#55FF5252" android:gravity="center" android:text="✕" android:textColor="#FFFFFF" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
